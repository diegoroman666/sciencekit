{
  "name": "sciencekit",
  "version": "1.0.0",
  "private": true,
  "description": "Analisis estadistico con motor en Python y UI en Tailwind CSS",
  "scripts": {
    "fetch:assets": "python3 scripts/fetch_pyodide.py && python3 scripts/fetch_fonts.py",
    "build:css": "tailwindcss -i ./src/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./static/css/app.css --watch",
    "build": "npm run fetch:assets && npm run build:css && python3 build.py",
    "dev": "python3 app.py"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoroman666/sciencekit.git"
  },
  "bugs": {
    "url": "https://github.com/diegoroman666/sciencekit/issues"
  },
  "homepage": "https://github.com/diegoroman666/sciencekit#readme"
}
